# Copy to .env and fill in real values before running locally or deploying.

# Postgres connection string (Neon, Supabase, Railway, RDS, etc.)
DATABASE_URL="postgresql://user:password@host:5432/tradeline"

# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET="replace-with-a-real-secret"

# Public site URL, used for canonical links, sitemap, and OG tags
NEXT_PUBLIC_SITE_URL="https://www.tradelinefl.com"

# Shared secret Vercel Cron sends as "Authorization: Bearer <value>" so
# scheduled jobs can call protected /api/admin/* routes without a login.
CRON_SECRET="replace-with-a-random-string"

# Powers the automated newsroom: drafts original articles from public news.
# console.anthropic.com -> Settings -> API Keys
ANTHROPIC_API_KEY="sk-ant-..."

# Powers the automated newsroom's public news search (licensed search API,
# not scraping). brave.com/search/api -> free tier is enough for daily runs.
BRAVE_SEARCH_API_KEY="replace-with-your-key"
